<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SimpleList.Pages.SettingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="using:SimpleList.Converters"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:wuc="using:WinUICommunity"
    xmlns:local="using:SimpleList"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:BoolNegationConverter x:Key="BoolNegationConverter" />
        <converter:BoolToNegativeVisibilityConverter x:Key="BoolToNegativeVisibilityConverter" />
    </Page.Resources>

    <Grid
        Padding="36 0 36 0"
        wuc:Growl.GrowlParent="True"
        wuc:Growl.Token="SettingGrowl">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Uid="SettingPage_Title"
                FontSize="30"
                FontWeight="Medium"
                Margin="0 20 0 0"/>
        <TextBlock Grid.Row="1"
                x:Uid="SettingPage_AppearanceTitle"
                FontWeight="Bold"
                Margin="0 10 0 10"/>
        <ScrollViewer Grid.Row="2">
            <StackPanel Orientation="Vertical"
                    Padding="0 0 0 32">
                <wuc:SettingsCard x:Uid="SettingPage_AppTheme">
                    <wuc:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE790;"/>
                    </wuc:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="themeMode"
                            wuc:ThemeServiceAttach.ThemeService="{x:Bind local:App.Current.GetThemeService}">
                        <ComboBoxItem x:Uid="SettingPage_Theme_Default"
                                Tag="Default"/>
                        <ComboBoxItem x:Uid="SettingPage_Theme_Light"
                                Tag="Light"/>
                        <ComboBoxItem x:Uid="SettingPage_Theme_Dark"
                                Tag="Dark"/>
                    </ComboBox>
                </wuc:SettingsCard>
                <wuc:SettingsCard x:Uid="SettingPage_AppMaterial">
                    <wuc:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xF5EF;"/>
                    </wuc:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="materialMode"
                            wuc:ThemeServiceAttach.ThemeService="{x:Bind local:App.Current.GetThemeService}">
                        <ComboBoxItem x:Uid="SettingPage_Material_None"
                                Tag="None"/>
                        <ComboBoxItem x:Uid="SettingPage_Material_Mica"
                                Tag="Mica"/>
                        <ComboBoxItem x:Uid="SettingPage_Material_MicaAlt"
                                Tag="MicaAlt"/>
                        <ComboBoxItem x:Uid="SettingPage_Material_DesktopAcrylic"
                                Tag="DesktopAcrylic"/>
                        <ComboBoxItem x:Uid="SettingPage_Material_AcrylicBase"
                                Tag="AcrylicBase"/>
                        <ComboBoxItem x:Uid="SettingPage_Material_AcrylicThin"
                                Tag="AcrylicThin"/>
                        <ComboBoxItem x:Uid="SettingPage_Material_Transparent"
                                Tag="Transparent"/>
                    </ComboBox>
                </wuc:SettingsCard>

                <TextBlock x:Uid="SettingPage_CloudTitle"
                        FontWeight="Bold"
                        Margin="0 10 0 10"/>
                <wuc:SettingsExpander x:Uid="SettingPage_CloudOAuth"
                        IsExpanded="False">
                    <wuc:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE753;"/>
                    </wuc:SettingsExpander.HeaderIcon>
                    <wuc:SettingsExpander.Items>
                        <wuc:SettingsCard>
                            <StackPanel Spacing="10">
                                <TextBox
                                    x:Name="OneDriveClientIdBox"
                                    x:Uid="SettingPage_OneDriveClientId" />
                                <TextBox
                                    x:Name="GoogleClientIdBox"
                                    x:Uid="SettingPage_GoogleClientId" />
                                <PasswordBox
                                    x:Name="GoogleClientSecretBox"
                                    x:Uid="SettingPage_GoogleClientSecret"
                                    PasswordRevealMode="Visible" />
                                <Button
                                    x:Name="SaveProviderSettingsButton"
                                    x:Uid="SettingPage_SaveProviderSettings"
                                    HorizontalAlignment="Right"
                                    Click="SaveProviderSettings" />
                            </StackPanel>
                        </wuc:SettingsCard>
                    </wuc:SettingsExpander.Items>
                </wuc:SettingsExpander>

                <TextBlock x:Uid="SettingPage_AboutTitle"
                        FontWeight="Bold"
                        Margin="0 10 0 10"/>
                <wuc:SettingsExpander x:Uid="SettingPage_About">
                    <wuc:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE753;"/>
                    </wuc:SettingsExpander.HeaderIcon>
                    <wuc:SettingsExpander.Items>
                        <wuc:SettingsCard Header="Github">
                            <wuc:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE943;" />
                            </wuc:SettingsCard.HeaderIcon>
                            <HyperlinkButton Content="https://github.com/aiguoli/SimpleList"
                                    NavigateUri="https://github.com/aiguoli/SimpleList"/>
                        </wuc:SettingsCard>

                        <wuc:SettingsCard Header="{x:Bind Version}">
                            <wuc:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE8EC;" />
                            </wuc:SettingsCard.HeaderIcon>
                            <Button x:Uid="SettingPage_CheckUpdate" Name="CheckUpdateButton" Click="CheckUpdate" Visibility="{x:Bind IsUpdateAvailable, Converter={StaticResource BoolToNegativeVisibilityConverter}, Mode=OneTime}" />
                        </wuc:SettingsCard>
                        <wuc:SettingsCard x:Name="StatusInfo" Visibility="Collapsed">
                            <wuc:SettingsCard.Header>
                                <TextBlock Name="NewVersion" x:Uid="SettingPage_NewVersionTip" />
                            </wuc:SettingsCard.Header>
                            <wuc:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE946;" />
                            </wuc:SettingsCard.HeaderIcon>
                            <StackPanel Spacing="8"
                                    HorizontalAlignment="Stretch">
                                <ScrollViewer MaxHeight="260"
                                        VerticalScrollBarVisibility="Auto"
                                        HorizontalScrollBarVisibility="Disabled"
                                        Visibility="{x:Bind IsUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneTime}">
                                    <TextBlock x:Name="ChangelogText"
                                            TextWrapping="Wrap"
                                            IsTextSelectionEnabled="True" />
                                </ScrollViewer>
                                <HyperlinkButton Name="DownloadButton" x:Uid="SettingPage_DownloadUpdate" Click="UpdateByPowershell" Visibility="Collapsed" />
                            </StackPanel>
                        </wuc:SettingsCard>
                    </wuc:SettingsExpander.Items>
                </wuc:SettingsExpander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
