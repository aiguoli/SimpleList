<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SimpleList.Pages.CloudPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:wuc="using:WinUICommunity"
    xmlns:vm="using:SimpleList.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" d:DataContext="{d:DesignInstance Type=vm:CloudViewModel}"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="DriveListItemStyle" TargetType="ListViewItem">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>

        <DataTemplate x:Key="DriveItemTemplate" x:DataType="vm:DriveViewModel">
            <Border
                HorizontalAlignment="Stretch"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <Border.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem
                            x:Uid="CloudPage_Flyout_GetCapacity"
                            Click="RefreshDriveCapacity_Click"
                            CommandParameter="{x:Bind}" />
                        <MenuFlyoutItem
                            x:Uid="CloudPage_Flyout_OpenTrash"
                            Click="OpenTrash_Click"
                            CommandParameter="{x:Bind}"
                            Visibility="{x:Bind CanManageTrash, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                        <MenuFlyoutItem
                            x:Uid="CloudPage_Flyout_RemoveDrive"
                            Click="RemoveDrive_Click"
                            CommandParameter="{x:Bind}" />
                    </MenuFlyout>
                </Border.ContextFlyout>
                <Grid
                    MinHeight="104"
                    Padding="14"
                    HorizontalAlignment="Stretch"
                    ColumnSpacing="16"
                    RowSpacing="8"
                    Tag="{x:Bind}"
                    DoubleTapped="NavigateToDrive">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="104" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.RowSpan="2"
                        Width="40"
                        Height="40"
                        VerticalAlignment="Center"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        CornerRadius="{ThemeResource ControlCornerRadius}">
                        <Image
                            Width="30"
                            Height="30"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Source="{x:Bind ProviderLogoSource, Mode=OneWay}"
                            Stretch="Uniform" />
                    </Border>

                    <StackPanel
                        Grid.Column="1"
                        MinWidth="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Spacing="4">
                        <TextBlock
                            MaxLines="1"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind DisplayName}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            MaxLines="1"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind AccountSummary}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            MaxLines="1"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind IdentifierSummary}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="2"
                        MinWidth="0"
                        VerticalAlignment="Center"
                        Spacing="7">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Uid="CloudPage_StorageLabel"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                            <StackPanel
                                Grid.Column="1"
                                MinWidth="0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="8">
                                <ProgressRing
                                    Width="14"
                                    Height="14"
                                    IsActive="{x:Bind IsCapacityLoading, Mode=OneWay}"
                                    Visibility="{x:Bind IsCapacityLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <TextBlock
                                    MaxLines="1"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind StorageStatus, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>

                        <ProgressBar
                            Height="8"
                            Maximum="100"
                            Value="{x:Bind StorageUsagePercent, Mode=OneWay}" />

                        <TextBlock
                            MaxLines="1"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind StorageDetails, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Spacing="8">
                        <TextBlock
                            MaxLines="1"
                            HorizontalAlignment="Right"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ProviderDisplayName}"
                            TextTrimming="CharacterEllipsis" />
                        <Button
                            Width="32"
                            Height="32"
                            Padding="0"
                            HorizontalAlignment="Right"
                            Background="Transparent"
                            BorderBrush="Transparent">
                            <FontIcon FontSize="14" Glyph="&#xE712;" />
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem
                                        x:Uid="CloudPage_Flyout_GetCapacity"
                                        Click="RefreshDriveCapacity_Click"
                                        CommandParameter="{x:Bind}" />
                                    <MenuFlyoutItem
                                        x:Uid="CloudPage_Flyout_OpenTrash"
                                        Click="OpenTrash_Click"
                                        CommandParameter="{x:Bind}"
                                        Visibility="{x:Bind CanManageTrash, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                                    <MenuFlyoutItem
                                        x:Uid="CloudPage_Flyout_RemoveDrive"
                                        Click="RemoveDrive_Click"
                                        CommandParameter="{x:Bind}" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                x:Uid="CloudPage_CreateDrive"
                HorizontalAlignment="Left"
                Click="ShowCreateDriveDialogAsync" />

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <ProgressRing
                    Width="18"
                    Height="18"
                    IsActive="{Binding IsLoadingDriveInfo}"
                    Visibility="{Binding IsLoadingDriveInfo, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{Binding DriveCountText}" />
            </StackPanel>
        </Grid>

        <ListView
            Grid.Row="1"
            Name="DirvePanel"
            HorizontalContentAlignment="Stretch"
            IsItemClickEnabled="False"
            ItemContainerStyle="{StaticResource DriveListItemStyle}"
            ItemTemplate="{StaticResource DriveItemTemplate}"
            ItemsSource="{Binding Drives}"
            SelectionMode="None" />
        <StackPanel
            Grid.Row="1"
            MinHeight="250"
            wuc:Growl.GrowlParent="True"
            wuc:Growl.Token="CloudGrowl" />
    </Grid>
</Page>
