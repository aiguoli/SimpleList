<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="SimpleList.Views.ShareFileView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SimpleList.ViewModels"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DataContext="{x:Bind vm:ShareFileViewModel}"
    x:Uid="ShareFileView"
    Loaded="ContentDialog_Loaded">

    <ContentControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:BoolNegationConverter x:Key="BoolNegationConverter" />
    </ContentControl.Resources>

    <StackPanel Orientation="Vertical">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock x:Uid="ShareFile_StatusLabel" VerticalAlignment="Center" />
            <TextBlock Text="{Binding ShareStatus, Mode=OneWay}" VerticalAlignment="Center" />
            <ProgressRing
                Width="16"
                Height="16"
                IsActive="{Binding IsLoadingShareStatus, Mode=OneWay}"
                Visibility="{Binding IsLoadingShareStatus, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
        </StackPanel>
        <ComboBox x:Uid="ShareFile_Scope" SelectedIndex="{Binding Type, Mode=TwoWay}">
            <ComboBoxItem x:Uid="ShareFile_Scope_View" />
            <ComboBoxItem x:Uid="ShareFile_Scope_Edit" />
        </ComboBox>
        <CalendarDatePicker 
            x:Uid="ShareFile_ExpirationDate"
            x:Name="ExpirationDateTime" 
            IsEnabled="{Binding SupportsExpiration}"
            Date="{Binding ExpirationDateTime, Mode=TwoWay}" />
        <TextBox x:Uid="ShareFile_Password" IsEnabled="{Binding SupportsPassword}" Text="{Binding Password, Mode=TwoWay}" />
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
            <Button
                x:Uid="ShareFile_ConfirmShare"
                Style="{StaticResource AccentButtonStyle}"
                IsEnabled="{Binding IsUpdatingShare, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}"
                Command="{Binding ShareFileCommand}" />
            <Button
                x:Uid="ShareFile_CancelShare"
                IsEnabled="{Binding IsUpdatingShare, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}"
                Command="{Binding RevokeShareCommand}"
                Visibility="{Binding IsShared, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
        </StackPanel>
        <StackPanel 
            Orientation="Horizontal" 
            Spacing="10"
            Visibility="{Binding Finished, Converter={StaticResource BoolToVisibilityConverter}, Mode=TwoWay}">
            <TextBox x:Uid="ShareFile_Link" Text="{Binding ShareLink}" MaxWidth="200" />
            <Button x:Name="CopyButton" x:Uid="ShareFile_Copy" VerticalAlignment="Bottom" Command="{Binding CopyToClipboardCommand}" />
            <Button x:Name="QRCodeButton" VerticalAlignment="Bottom" Click="ShowQRCode">
                <FontIcon Glyph="&#xED14;" />
            </Button>
            <TeachingTip x:Name="QRCodeTip" Target="{x:Bind QRCodeButton}">
                <Image Source="{Binding QRCodeImage}" Margin="25" />
            </TeachingTip>
        </StackPanel>
    </StackPanel>
</ContentDialog>
