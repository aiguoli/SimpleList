<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SimpleList.Pages.DrivePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="using:SimpleList.Converters"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SimpleList.Models"
    xmlns:views="using:SimpleList.Views.Layout"
    xmlns:vm="using:SimpleList.ViewModels"
    xmlns:wuc="using:WinUICommunity"
    d:DataContext="{x:Bind vm:DriveViewModel}"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Page.Resources>
        <converter:FileSizeConverter x:Key="FileSizeConverter" />
        <converter:DateTimeOffsetToStringConverter x:Key="DateTimeOffsetToStringConverter" />
        <converters:BoolToObjectConverter
            x:Key="BoolToObjectConverter"
            FalseValue="Visible"
            TrueValue="Collapsed" />

        <DataTemplate x:Key="ColumnViewTemplate">
            <views:ColumnCloudView />
        </DataTemplate>
        <DataTemplate x:Key="GridViewTemplate">
            <views:GridCloudView />
        </DataTemplate>
        <DataTemplate x:Key="ImageViewTemplate">
            <views:ImageCloudView DataContext="{Binding}" />
        </DataTemplate>
    </Page.Resources>

    <Grid VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ProgressBar
            Width="200"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsIndeterminate="True"
            ShowError="False"
            ShowPaused="False"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
        <RelativePanel Grid.Row="1" Margin="10,5,10,5">
            <BreadcrumbBar
                x:Name="BreadcrumbBar"
                ItemClicked="BreadcrumbBar_ItemClicked"
                ItemsSource="{x:Bind ViewModel.BreadcrumbItems, Mode=OneWay}"
                KeyboardAcceleratorPlacementMode="Hidden">
                <BreadcrumbBar.ItemTemplate>
                    <DataTemplate x:DataType="models:BreadcrumbItem">
                        <BreadcrumbBarItem
                            AutomationProperties.Name="{Binding Name}"
                            Content="{Binding}"
                            Tag="{Binding ItemId}">
                            <BreadcrumbBarItem.ContentTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="5,0,5,0" Text="{Binding Name}" />
                                </DataTemplate>
                            </BreadcrumbBarItem.ContentTemplate>
                        </BreadcrumbBarItem>
                    </DataTemplate>
                </BreadcrumbBar.ItemTemplate>
                <BreadcrumbBar.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Back" Invoked="BackToLastFolder" />
                    <KeyboardAccelerator
                        Key="Left"
                        Invoked="BackToLastFolder"
                        Modifiers="Menu" />
                    <KeyboardAccelerator Key="Right" Modifiers="Menu" />
                </BreadcrumbBar.KeyboardAccelerators>
            </BreadcrumbBar>
            <StackPanel Orientation="Horizontal" RelativePanel.AlignRightWithPanel="True">
                <Button Margin="0,0,5,0" Click="ShowSearchDialogAsync" ToolTipService.ToolTip="搜索">
                    <FontIcon
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Glyph="&#xE721;" />
                </Button>
                <Button Margin="0,0,5,0" Click="SplitButton_Click" ToolTipService.ToolTip="上传文件">
                    <FontIcon
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Glyph="&#xE898;" />
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:Uid="CloudPage_UploadFile" Click="ShowUploadFileDialogAsync" />
                            <MenuFlyoutItem x:Uid="CloudPage_UploadFolder" Click="ShowUploadFolderDialogAsync" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button Margin="0,0,5,0" Click="CreateFolderDialogAsync" ToolTipService.ToolTip="新建文件夹">
                    <FontIcon
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Glyph="&#xE8F4;" />
                </Button>
                <Button x:Name="RefreshButton" Command="{x:Bind ViewModel.RefreshCommand, Mode=OneWay}" ToolTipService.ToolTip="刷新">
                    <FontIcon
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Glyph="&#xE72C;" />
                </Button>
            </StackPanel>
        </RelativePanel>
        <ContentControl
            x:Name="CloudControl"
            Grid.Row="2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            AllowDrop="True"
            ContentTemplate="{StaticResource ColumnViewTemplate}"
            DragOver="DisplayCopyIcon"
            Drop="DropToUpload">
            <ContentControl.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem x:Uid="CloudPage_Refresh" Command="{x:Bind ViewModel.RefreshCommand, Mode=OneWay}">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F5" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutSubItem x:Uid="CloudPage_Upload">
                        <MenuFlyoutItem x:Uid="CloudPage_UploadFile" Click="ShowUploadFileDialogAsync">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="U" Modifiers="Control" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Uid="CloudPage_UploadFolder" Click="ShowUploadFolderDialogAsync">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="U" Modifiers="Control,Shift" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                    </MenuFlyoutSubItem>
                    <MenuFlyoutItem x:Uid="CloudPage_CreateFolder" Click="CreateFolderDialogAsync">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="N" Modifiers="Control,Shift" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutSubItem x:Uid="CloudPage_Layout">
                        <MenuFlyoutItem
                            x:Uid="CloudPage_Layout_Column"
                            Click="ChangeLayout"
                            Tag="Column" />
                        <MenuFlyoutItem
                            x:Uid="CloudPage_Layout_Grid"
                            Click="ChangeLayout"
                            Tag="Grid" />
                        <MenuFlyoutItem
                            x:Uid="CloudPage_Layout_Image"
                            Click="ChangeLayout"
                            Tag="Image" />
                    </MenuFlyoutSubItem>
                </MenuFlyout>
            </ContentControl.ContextFlyout>
        </ContentControl>
        <TextBlock 
            Grid.Row="2" 
            HorizontalAlignment="Right" 
            VerticalAlignment="Bottom" 
            Margin="0,0,20,30" 
            Foreground="Black" 
            IsHitTestVisible="False" 
            Text="{x:Bind ViewModel.SelectionStatus, Mode=OneWay}" />
        <StackPanel
            Grid.Row="2" 
            MinHeight="250"
            Margin="0"
            wuc:Growl.GrowlParent="True"
            wuc:Growl.Token="DriveGrowl">
        </StackPanel>
    </Grid>
</Page>
