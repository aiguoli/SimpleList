<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SimpleList.Views.Preview.MediaPreviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SimpleList.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Closed="Window_Closed">

    <Grid
        x:Name="RootGrid"
        Padding="16"
        RowSpacing="12"
        d:DataContext="{x:Bind vm:PreviewViewModel}"
        Loaded="LoadDownloadUrlAsync">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <MediaPlayerElement
            Name="Player"
            AreTransportControlsEnabled="True"
            Source="{Binding Media}" />

        <Button
            Grid.Row="1"
            x:Uid="MediaPreviewView_CloseButton"
            HorizontalAlignment="Right"
            Click="CloseButton_Click" />
    </Grid>
</Window>
