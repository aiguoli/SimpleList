<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="SimpleList.Views.Tools.CreateLink"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SimpleList.ViewModels.Tools"
    mc:Ignorable="d"
    d:DataContext="{x:Bind vm:CreateLinkViewModel}"
    x:Uid="ShareCommunityCreateLinkView"
    PrimaryButtonCommand="{Binding CreateLinkCommand}"
    DefaultButton="Primary">

    <StackPanel Orientation="Vertical">
        <TextBox x:Uid="ShareCommunityCreateLinkPage_Title" Text="{Binding Title, Mode=TwoWay}" />
        <TextBox x:Uid="ShareCommunityCreateLinkPage_Content" Height="100" TextWrapping="Wrap" Text="{Binding Url, Mode=TwoWay}" />
        <TextBox x:Uid="ShareCommunityCreateLinkPage_Password" Text="{Binding Password, Mode=TwoWay}" IsEnabled="{Binding SupportsPassword}" />
        <CalendarDatePicker x:Uid="ShareCommunityCreateLinkPage_ExpirationDate" MinDate="{Binding Today}" Date="{Binding Expiration, Mode=TwoWay}" IsEnabled="{Binding SupportsExpiration}" />
        <ComboBox x:Uid="ShareCommunityCreateLinkPage_Category" ItemsSource="{Binding Providers}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedProvider, Mode=TwoWay}" />
    </StackPanel>
</ContentDialog>
