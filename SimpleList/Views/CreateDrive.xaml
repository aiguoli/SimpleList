<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="SimpleList.Views.CreateDrive"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:vm="using:SimpleList.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DataContext="{x:Bind vm:CreateDriveViewModel}"
    x:Uid="CreateDrive"
    Title="Create drive"
    DefaultButton="Primary"
    PrimaryButtonText="Create"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    CloseButtonText="Cancel">

    <ContentDialog.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </ContentDialog.Resources>

    <StackPanel Spacing="10">
        <TextBlock x:Uid="CreateDrive_Provider" Text="Provider" Margin="10,10,10,0" />
        <ComboBox SelectedIndex="{Binding ProviderTypeIndex, Mode=TwoWay}" Margin="10,0,10,0" HorizontalAlignment="Stretch">
            <ComboBoxItem Content="OneDrive" />
            <ComboBoxItem Content="Google Drive" />
            <ComboBoxItem x:Uid="CreateDrive_Provider_Local" Content="Local" />
            <ComboBoxItem Content="PikPak" />
        </ComboBox>
        <TextBox x:Name="DriveName" x:Uid="CreateDrive_DisplayName" Header="Display name (optional)" PlaceholderText="Drive name" Text="{Binding DisplayName, Mode=TwoWay}" Margin="10,0,10,10" />
        <Grid
            Margin="10,0,10,10"
            ColumnSpacing="8"
            Visibility="{Binding IsLocalProviderSelected, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Uid="CreateDrive_LocalPath"
                Header="Local folder path"
                PlaceholderText="C:\Data\MyDrive"
                Text="{Binding LocalPath, Mode=TwoWay}" />
            <Button
                Grid.Column="1"
                VerticalAlignment="Bottom"
                Click="BrowseLocalPath_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon Symbol="Folder" />
                    <TextBlock x:Uid="CreateDrive_Browse" Text="Browse" />
                </StackPanel>
            </Button>
        </Grid>
        <StackPanel
            Margin="10,0,10,10"
            Spacing="8"
            Visibility="{Binding IsPikPakProviderSelected, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBox
                x:Uid="CreateDrive_PikPakUsername"
                Header="Username"
                Text="{Binding PikPakUsername, Mode=TwoWay}" />
            <PasswordBox
                x:Uid="CreateDrive_PikPakPassword"
                Header="Password"
                PasswordChanged="PikPakPassword_PasswordChanged" />
            <CheckBox
                x:Uid="CreateDrive_PikPakRememberPassword"
                Content="Remember account and password"
                IsChecked="{Binding PikPakRememberPassword, Mode=TwoWay}" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
