<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SimpleList.Views.Layout.ColumnCloudView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SimpleList.ViewModels"
    xmlns:views="using:SimpleList.Views.Layout"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{x:Bind vm:DriveViewModel}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="ListItemTemplate" x:DataType="vm:FileViewModel">
            <!-- DataContext is established implicitly by the ListView, so we don't strictly need to pass it, but x:Bind ignores DataContext by default without a property. Still using Binding for DataContext is fine here. -->
            <views:ColumnFileView DataContext="{x:Bind}" />
        </DataTemplate>
    </UserControl.Resources>

    <ListView
        x:Name="FileListView"
        CanDragItems="{x:Bind ViewModel.CanSearch, Mode=OneWay}"
        DragItemsStarting="StartFileDrag"
        ItemsSource="{x:Bind ViewModel.Files, Mode=OneWay}" 
        ItemTemplate="{StaticResource ListItemTemplate}"
        SelectionMode="Extended"
        SelectionChanged="ChangeSelectedFiles"
        VerticalAlignment="Stretch">
        <ListView.ItemContainerTransitions>
            <TransitionCollection />
        </ListView.ItemContainerTransitions>
    </ListView>
</UserControl>
